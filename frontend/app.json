{
  "expo": {
    "name": "B-APP Baccarat Engine",
    "slug": "bapp-baccarat-engine",
    "version": "0.1.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "bapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bapp.baccaratengine"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0F14"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bapp.baccaratengine",
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
